# Skopiuj ten plik do .env.local i zastap wartosci przykladowe.
# .env.local pozostaje tylko na Twoim komputerze.
Supabase__Url=https://YOUR-PROJECT.supabase.co
Supabase__PublishableKey=YOUR_PUBLISHABLE_KEY
ConnectionStrings__SupabaseDatabase=Host=YOUR-DATABASE-HOST;Port=5432;Database=postgres;Username=YOUR_DATABASE_USER;Password=YOUR_DATABASE_PASSWORD;SSL Mode=Require
ASPNETCORE_Kestrel__Certificates__Default__Password=YOUR_LOCAL_CERTIFICATE_PASSWORD
