# Skopiuj ten plik do .env.local i zastap tylko wartosci po znaku =.
# Zachowaj nazwy zmiennych dokladnie jak ponizej: podwojne __ oznacza : w konfiguracji .NET.
# .env.local pozostaje tylko na Twoim komputerze.
Supabase__Url=https://YOUR-PROJECT.supabase.co
Supabase__PublishableKey=YOUR_PUBLISHABLE_KEY
Supabase__SecretKey=YOUR_SECRET_KEY
Mailtrap__ApiToken=YOUR_MAILTRAP_API_TOKEN
# Lokalnie z domena Demo mozna sprobowac hello@demomailtrap.co; wysylka tylko na adres konta Mailtrap.
Mailtrap__FromEmail=sender@YOUR_VERIFIED_DOMAIN
Mailtrap__FromName=E-commerce
PasswordReset__Url=https://YOUR-FRONTEND-DOMAIN/reset-password
ConnectionStrings__SupabaseDatabase=Host=YOUR-DATABASE-HOST;Port=5432;Database=postgres;Username=YOUR_DATABASE_USER;Password=YOUR_DATABASE_PASSWORD;SSL Mode=Require
ASPNETCORE_Kestrel__Certificates__Default__Password=YOUR_LOCAL_CERTIFICATE_PASSWORD
